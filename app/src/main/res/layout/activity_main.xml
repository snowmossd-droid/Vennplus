<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TikTok RTMP Streamer"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server URL (RTMP)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="rtmp://push.tiktok.com/live/..."
        android:inputType="textUri"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stream Key"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editStreamKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dán Stream Key lấy từ TikTok Live Studio"
        android:inputType="textPassword"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chat bridge WS URL (không bắt buộc)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editChatWsUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ws://127.0.0.1:8765"
        android:inputType="textUri"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bắt đầu Live" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Dừng Live"
        android:enabled="false" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Trạng thái: Chưa live"
        android:textSize="14sp" />

</LinearLayout>
